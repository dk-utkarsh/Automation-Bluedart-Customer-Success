# Copy to .env and fill in. Real values are never committed - see .gitignore.

# Zoho Desk credentials
ZOHO_DESK_URL=
ZOHO_DESK_EMAIL=
ZOHO_DESK_PASSWORD=

# Zoho Desk API (OAuth 2.0 - India DC)
# Client id/secret: https://api-console.zoho.in
# Org id:           Desk > Setup > Organization details
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=
ZOHO_API_DOMAIN=
ZOHO_SCOPE=
# Optional - a single-org token resolves the org by itself.
ZOHO_ORG_ID=

# Optional - only needed if Chrome is not in a standard location. Left blank,
# the usual install paths for the platform are searched, then PATH.
# Linux example: /usr/bin/google-chrome
CHROME_BINARY=

# ClickPost credentials
# NOTE: Login is 2-step - after email+password, an OTP is emailed to the
# registered address and must be entered before the portal opens.
CLICKPOST_URL=
CLICKPOST_EMAIL=
CLICKPOST_PASSWORD=

# Mailbox that receives the ClickPost OTP (IMAP used to read it)
OTP_EMAIL=
OTP_EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=

# Daily Mapping report recipients (MAIL_CC optional, comma-separated)
MAIL_TO=
MAIL_CC=
MAIL_FROM=
MAIL_GREETING_NAME=

# Zoho Mail incoming webhook - TEST URL, to be replaced with the final one.
# Purpose: replies to the escalation mail land here, so the matching Desk ticket
# can be updated from the reply. Not read by main.py yet - stored for that work.
ZOHO_MAIL_INCOMING_WEBHOOK=

# PostgreSQL persistence (db.py). Without this every db.* call is a silent
# no-op and the pipeline runs on its JSON files alone - which is what was
# happening before: the tables existed but nothing was ever written to them.
# Apply db/schema.sql once, then set this. main.py prints ON or OFF at startup.
#   psql -d bluedart_escalation -f db/schema.sql
DATABASE_URL=postgresql://bluedart_app:PASSWORD@localhost:5432/bluedart_escalation
